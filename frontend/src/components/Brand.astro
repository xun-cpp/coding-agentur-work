---
interface Props {
  size?: number;
}
const { size = 26 } = Astro.props;
---

<a class="brand" href="/" aria-label="Coding Agentur – zur Startseite">
  <span class="brand__mark" style={`--s:${size}px`} aria-hidden="true">
    <svg viewBox="0 0 32 32" fill="none">
      <rect x="1.25" y="1.25" width="29.5" height="29.5" rx="8.5" class="brand__badge"></rect>
      <path d="M13 11 8.75 16 13 21" class="brand__stroke"></path>
      <path d="M19 11l4.25 5L19 21" class="brand__stroke"></path>
      <path d="M17.4 9 14.6 23" class="brand__slash"></path>
    </svg>
  </span>
  <span class="brand__word">Coding&nbsp;<span>Agentur</span></span>
</a>

<style>
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.58rem;
  }
  .brand__mark {
    width: var(--s, 26px);
    height: var(--s, 26px);
    display: block;
  }
  .brand__mark svg {
    width: 100%;
    height: 100%;
    overflow: visible;
  }
  .brand__badge {
    fill: var(--brand);
  }
  .brand__stroke {
    stroke: #fff;
    stroke-width: 2.4;
    stroke-linecap: round;
    stroke-linejoin: round;
    fill: none;
  }
  .brand__slash {
    stroke: #dce6ff;
    stroke-width: 2.4;
    stroke-linecap: round;
  }
  .brand__word {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--ink);
    white-space: nowrap;
  }
  .brand__word span {
    color: var(--ink-3);
  }
  .brand:hover .brand__badge {
    fill: #3158cc;
  }
</style>
