---
import BaseLayout from '../layouts/BaseLayout.astro';
import { services, site } from '../config/site';
import { serviceSeo } from '../config/service-seo';
import { locations } from '../config/locations';

export function getStaticPaths() {
  return services.map((service) => ({ params: { service: service.slug }, props: { service } }));
}
const { service } = Astro.props;
const seo = serviceSeo[service.slug];
const origin = `https://${site.domain}`;
const url = `${origin}/${service.slug}/`;
const title = seo?.title ?? `${service.label} – Coding Agentur`;
const description = seo?.description ?? service.description;

const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Service',
      '@id': `${url}#service`,
      name: service.title,
      alternateName: service.label,
      serviceType: service.label,
      description,
      url,
      provider: { '@id': `${origin}/#business` },
      areaServed: [
        { '@type': 'City', name: 'Gütersloh' },
        { '@type': 'Country', name: 'Deutschland' },
      ],
      hasOfferCatalog: {
        '@type': 'OfferCatalog',
        name: service.label,
        itemListElement: service.items.map((item: string) => ({
          '@type': 'Offer',
          itemOffered: { '@type': 'Service', name: item },
        })),
      },
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Startseite', item: `${origin}/` },
        { '@type': 'ListItem', position: 2, name: 'Leistungen', item: `${origin}/leistungen/` },
        { '@type': 'ListItem', position: 3, name: service.label, item: url },
      ],
    },
    ...(seo
      ? [
          {
            '@type': 'FAQPage',
            '@id': `${url}#faq`,
            mainEntity: seo.faq.map((entry) => ({
              '@type': 'Question',
              name: entry.q,
              acceptedAnswer: { '@type': 'Answer', text: entry.a },
            })),
          },
        ]
      : []),
  ],
};
---

<BaseLayout {title} {description} ogImage="/og/leistungen.png">
  <script type="application/ld+json" is:inline set:html={JSON.stringify(structuredData)} />
  <nav class="crumbs" aria-label="Brotkrumen">
    <div class="shell">
      <a href="/">Start</a><span aria-hidden="true">/</span>
      <a href="/leistungen/">Leistungen</a><span aria-hidden="true">/</span>
      <span aria-current="page">{service.label}</span>
    </div>
  </nav>
  <section class="page-hero">
    <div class="shell page-hero__copy reveal">
      <p class="eyebrow eyebrow--dot">{service.eyebrow}</p>
      <h1>{service.title}</h1>
      <p class="page-hero__lead">{service.description}</p>
      <div class="page-hero__meta">
        <span>Individuell geplant</span>
        <span>Sauber umgesetzt</span>
        <span>Erweiterbar angelegt</span>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="shell service-detail">
      <aside class="service-detail__sticky reveal">
        <p class="eyebrow">Ihr Vorhaben</p>
        <h2>Die Technik soll den Ablauf vereinfachen.</h2>
        <p>
          Wir klären gemeinsam, was wirklich gebraucht wird, welche Systeme dazugehören und wie sich die Lösung
          langfristig pflegen lässt.
        </p>
        <a class="btn btn--signal" href="/kontakt/">
          Projekt besprechen
          <svg
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"><path d="M5 12h13M13 6l6 6-6 6"></path></svg
          >
        </a>
      </aside>

      <div class="service-detail__content">
        <article class="reveal">
          <h3>Was möglich ist</h3>
          <p>
            Der Umfang richtet sich nach dem Bedarf Ihres Unternehmens. Aus klaren Anforderungen entsteht eine Lösung,
            die sich sinnvoll bedienen, betreiben und weiterentwickeln lässt.
          </p>
          <ul>
            {service.items.map((item: string) => <li>{item}</li>)}
          </ul>
        </article>
        <article class="reveal" style="--d:.06s">
          <h3>Wie wir vorgehen</h3>
          <p>
            Wir verbinden fachliche Anforderungen mit Design, Architektur und Umsetzung. Schnittstellen, Rechte und
            Datenflüsse werden von Anfang an mitgedacht – nicht erst nach dem ersten Entwurf.
          </p>
        </article>
        <article class="reveal" style="--d:.12s">
          <h3>Nach dem Launch</h3>
          <p>
            Eine digitale Lösung bleibt ein lebendiges Werkzeug. Auf Wunsch übernehmen wir technische Updates,
            Anpassungen, neue Funktionen und die laufende Weiterentwicklung.
          </p>
        </article>
      </div>
    </div>
  </section>

  {
    seo && (
      <section class="section faq-section">
        <div class="shell faq">
          <div class="faq__head reveal">
            <p class="eyebrow eyebrow--dot">Fragen &amp; Antworten</p>
            <h2>{seo.heading}</h2>
            <p class="faq__intro">{seo.intro}</p>
          </div>
          <div class="faq__list">
            {seo.faq.map((entry, index) => (
              <details class="faq__item reveal" style={`--d:${index * 0.04}s`} open={index === 0}>
                <summary>
                  <span>{entry.q}</span>
                  <i aria-hidden="true" />
                </summary>
                <p>{entry.a}</p>
              </details>
            ))}
          </div>
        </div>

        <div class="shell faq__cross">
          <p class="eyebrow">Weitere Leistungen</p>
          <div class="faq__links">
            {services
              .filter((item) => item.slug !== service.slug)
              .map((item) => (
                <a href={`/${item.slug}/`}>{item.label}</a>
              ))}
            <a href="/ueber-uns/">Über uns</a>
          </div>
        </div>

        <div class="shell faq__cross">
          <p class="eyebrow">{service.label} in Ihrer Stadt</p>
          <div class="faq__links">
            {locations.slice(0, 10).map((location) => (
              <a href={`/webdesign/${location.slug}/`}>
                {service.label} {location.city}
              </a>
            ))}
            <a href="/webdesign/">Alle Standorte</a>
          </div>
        </div>
      </section>
    )
  }
</BaseLayout>
