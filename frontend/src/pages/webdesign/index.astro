---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { site } from '../../config/site';
import { locations } from '../../config/locations';

const origin = `https://${site.domain}`;
const url = `${origin}/webdesign/`;
const title = 'Webdesign & Programmierung in OWL und NRW | Coding Agentur';
const description = `Webdesign, Website erstellen lassen, Apps und Kassensysteme – in Gütersloh, Bielefeld, Dortmund, Köln, Hamburg und ${locations.length - 5} weiteren Städten. Alle Standorte der Coding Agentur.`;

const order = ['Kreis Gütersloh', 'Ostwestfalen-Lippe', 'Nordrhein-Westfalen', 'Deutschland'] as const;
const groups = order
  .map((name) => ({ name, items: locations.filter((entry) => entry.group === name) }))
  .filter((group) => group.items.length > 0);

const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'CollectionPage',
      '@id': `${url}#webpage`,
      url,
      name: title,
      description,
      inLanguage: 'de-DE',
      isPartOf: { '@id': `${origin}/#website` },
      about: { '@id': `${origin}/#business` },
      mainEntity: {
        '@type': 'ItemList',
        itemListElement: locations.map((location, index) => ({
          '@type': 'ListItem',
          position: index + 1,
          name: `Webdesign ${location.city}`,
          url: `${origin}/webdesign/${location.slug}/`,
        })),
      },
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Startseite', item: `${origin}/` },
        { '@type': 'ListItem', position: 2, name: 'Standorte', item: url },
      ],
    },
  ],
};
---

<BaseLayout {title} {description} ogImage="/og/leistungen.png">
  <script type="application/ld+json" is:inline set:html={JSON.stringify(structuredData)} />

  <nav class="crumbs" aria-label="Brotkrumen">
    <div class="shell">
      <a href="/">Start</a><span aria-hidden="true">/</span>
      <span aria-current="page">Standorte</span>
    </div>
  </nav>

  <section class="page-hero">
    <div class="shell page-hero__copy reveal">
      <p class="eyebrow eyebrow--dot">Region</p>
      <h1>Wo wir arbeiten.</h1>
      <p class="page-hero__lead">
        Wir sitzen in Gütersloh und bauen Websites, Apps und Kassensysteme für Betriebe in Ostwestfalen-Lippe, im
        Münsterland und in ganz Deutschland. Für die Städte, in denen wir besonders häufig unterwegs sind, finden Sie
        hier den passenden Einstieg.
      </p>
      <div class="page-hero__meta">
        <span>{locations.length} Standorte</span>
        <span>Deutschlandweit tätig</span>
        <span>Erstgespräch kostenlos</span>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="shell">
      {
        groups.map((group, groupIndex) => (
          <div class="city-group">
            <div class="city-group__head reveal">
              <p class="section-kicker">
                <span>{String(groupIndex + 1).padStart(2, '0')} /</span>
                {group.name}
              </p>
              <span class="city-group__count">{group.items.length} Städte</span>
            </div>
            <div class="city-grid">
              {group.items.map((location, index) => (
                <a class="city-card reveal" style={`--d:${(index % 8) * 0.03}s`} href={`/webdesign/${location.slug}/`}>
                  <b>{location.city}</b>
                  <span class="city-card__region">{location.region}</span>
                  <span class="city-card__travel">{location.travel}</span>
                  <i aria-hidden="true">↗</i>
                </a>
              ))}
            </div>
          </div>
        ))
      }
      <p class="city-note">
        Ihre Stadt ist nicht dabei? Kein Problem – wir arbeiten deutschlandweit.
        <a class="link" href="/kontakt/"
          >Schreiben Sie uns
          <svg
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"><path d="M5 12h13M13 6l6 6-6 6"></path></svg
          >
        </a>
      </p>
    </div>
  </section>
</BaseLayout>

<style>
  .city-group + .city-group {
    margin-top: clamp(34px, 5vw, 56px);
  }
  .city-group__head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--sp-4);
    margin-bottom: var(--sp-4);
    padding-bottom: var(--sp-3);
    border-bottom: 1px solid var(--line);
  }
  .city-group__count {
    font-family: var(--font-mono);
    font-size: var(--fs-mono);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--ink-4);
  }
  .city-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: clamp(10px, 1.4vw, 16px);
  }
  .city-card {
    position: relative;
    display: grid;
    gap: 4px;
    padding: var(--sp-4) var(--sp-5) var(--sp-4) var(--sp-4);
    border: 1px solid var(--line);
    border-radius: var(--r-2);
    background: var(--panel);
    transition:
      transform 0.3s var(--e),
      border-color 0.3s,
      box-shadow 0.3s;
  }
  .city-card:hover {
    transform: translateY(-3px);
    border-color: var(--brand);
    box-shadow: 0 18px 30px -24px #33436e66;
  }
  .city-card b {
    font-size: var(--fs-base);
    font-weight: 545;
    letter-spacing: -0.02em;
  }
  .city-card__region {
    font-size: var(--fs-sm);
    color: var(--ink-3);
    line-height: 1.45;
  }
  .city-card__travel {
    font-family: var(--font-mono);
    font-size: var(--fs-mono);
    color: var(--ink-4);
    letter-spacing: 0.04em;
  }
  .city-card i {
    position: absolute;
    top: var(--sp-3);
    right: var(--sp-3);
    font-size: 0.75rem;
    font-style: normal;
    color: var(--ink-4);
    transition:
      color 0.25s,
      transform 0.25s;
  }
  .city-card:hover i {
    color: var(--brand);
    transform: translate(2px, -2px);
  }
  .city-note {
    margin-top: var(--sp-6);
    padding-top: var(--sp-5);
    border-top: 1px solid var(--line);
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--sp-4);
    font-size: var(--fs-sm);
    color: var(--ink-3);
  }
  @media (max-width: 1050px) {
    .city-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }
  @media (max-width: 780px) {
    .city-grid {
      grid-template-columns: 1fr 1fr;
    }
  }
  @media (max-width: 470px) {
    .city-grid {
      grid-template-columns: 1fr;
    }
    .city-card__travel {
      display: none;
    }
  }
</style>
