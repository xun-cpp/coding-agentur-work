---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { site } from '../../config/site';
import { locations } from '../../config/locations';

export function getStaticPaths() {
  return locations.map((location) => ({ params: { stadt: location.slug }, props: { location } }));
}

const { location } = Astro.props;
const origin = `https://${site.domain}`;
const url = `${origin}/webdesign/${location.slug}/`;

const title = `Webdesign ${location.city} | Websites, Apps & Kassensysteme`;
const description = `Website erstellen lassen ${location.inCity}: individuelle Webentwicklung, Web-Apps, iOS- und Android-Apps und Kassensysteme von der Coding Agentur aus Gütersloh. ${location.travel}`;

const nearby = locations.filter((entry) => entry.slug !== location.slug).slice(0, 8);

const offers = [
  {
    label: 'Website erstellen lassen',
    slug: 'websites',
    line: `Unternehmensauftritte für Betriebe ${location.inCity} – schnell, mobil, auffindbar.`,
  },
  { label: 'Kassensystem', slug: 'kassensysteme', line: 'Bestellung, Zahlung, Beleg und Auswertung in einem Ablauf.' },
  { label: 'App-Entwicklung', slug: 'apps', line: 'iOS und Android für Kunden, Teams und den Aussendienst.' },
  {
    label: 'Web-App & Portal',
    slug: 'web-apps',
    line: 'Aufträge, Termine und Dokumente an einem Ort statt in fünf Tabellen.',
  },
  { label: 'Onlineshop', slug: 'webshops', line: 'Verkaufen mit Katalog, Warenkorb, Zahlung und Versand.' },
  {
    label: 'Schnittstellen & APIs',
    slug: 'integrationen',
    line: 'Bestehende Systeme verbinden, statt Daten doppelt zu tippen.',
  },
];

const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebPage',
      '@id': `${url}#webpage`,
      url,
      name: title,
      description,
      inLanguage: 'de-DE',
      isPartOf: { '@id': `${origin}/#website` },
      about: { '@id': `${origin}/#business` },
    },
    {
      '@type': 'Service',
      '@id': `${url}#service`,
      name: `Webdesign und Softwareentwicklung ${location.inCity}`,
      serviceType: 'Webdesign, Webentwicklung, App-Entwicklung, Kassensysteme',
      description,
      url,
      provider: { '@id': `${origin}/#business` },
      areaServed: {
        '@type': 'City',
        name: location.city,
        address: { '@type': 'PostalAddress', addressLocality: location.city, addressCountry: 'DE' },
      },
      hasOfferCatalog: {
        '@type': 'OfferCatalog',
        name: `Leistungen ${location.inCity}`,
        itemListElement: offers.map((offer) => ({
          '@type': 'Offer',
          itemOffered: {
            '@type': 'Service',
            name: `${offer.label} ${location.inCity}`,
            url: `${origin}/${offer.slug}/`,
          },
        })),
      },
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Startseite', item: `${origin}/` },
        { '@type': 'ListItem', position: 2, name: 'Standorte', item: `${origin}/webdesign/` },
        { '@type': 'ListItem', position: 3, name: location.city, item: url },
      ],
    },
    {
      '@type': 'FAQPage',
      '@id': `${url}#faq`,
      mainEntity: location.faq.map((entry) => ({
        '@type': 'Question',
        name: entry.q,
        acceptedAnswer: { '@type': 'Answer', text: entry.a },
      })),
    },
  ],
};
---

<BaseLayout {title} {description} ogImage="/og/leistungen.png">
  <script type="application/ld+json" is:inline set:html={JSON.stringify(structuredData)} />

  <nav class="crumbs" aria-label="Brotkrumen">
    <div class="shell">
      <a href="/">Start</a><span aria-hidden="true">/</span>
      <a href="/webdesign/">Standorte</a><span aria-hidden="true">/</span>
      <span aria-current="page">{location.city}</span>
    </div>
  </nav>

  <section class="page-hero">
    <div class="shell page-hero__copy reveal">
      <p class="eyebrow eyebrow--dot">{location.region}</p>
      <h1>Webdesign & Software {location.inCity}.</h1>
      <p class="page-hero__lead">{location.intro}</p>
      <div class="page-hero__meta">
        <span>{location.travel}</span>
        <span>Direkt mit den Entwicklern</span>
        <span>Erstgespräch kostenlos</span>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="shell local-grid">
      <div class="reveal">
        <p class="section-kicker"><span>01 /</span>Lage</p>
        <h2 class="section-title">Warum Betriebe {location.inCity} <em>bei uns landen.</em></h2>
        <p class="local-text">{location.situation}</p>
        <ul class="local-focus">
          {location.focus.map((item) => <li>{item}</li>)}
        </ul>
      </div>
      <div class="local-card reveal" style="--d:.08s">
        <div class="local-card__row"><span>Standort</span><b>Gütersloh</b></div>
        <div class="local-card__row"><span>Einsatzort</span><b>{location.city}</b></div>
        <div class="local-card__row"><span>Anfahrt</span><b>{location.travel}</b></div>
        <div class="local-card__row">
          <span>Kontakt</span><b><a href={`mailto:${site.contactEmail}`}>{site.contactEmail}</a></b>
        </div>
        <a class="btn btn--signal local-card__cta" href="/kontakt/">
          Projekt {location.inCity} anfragen
          <svg
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"><path d="M5 12h13M13 6l6 6-6 6"></path></svg
          >
        </a>
      </div>
    </div>
  </section>

  <section class="section section--alt">
    <div class="shell">
      <div class="reveal">
        <p class="section-kicker"><span>02 /</span>Leistungen</p>
        <h2 class="section-title">Was wir {location.inCity} bauen.</h2>
      </div>
      <div class="local-offers">
        {
          offers.map((offer, index) => (
            <a class="local-offer reveal" style={`--d:${index * 0.04}s`} href={`/${offer.slug}/`}>
              <b>{offer.label}</b>
              <span>{offer.line}</span>
              <i aria-hidden="true">↗</i>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section faq-section">
    <div class="shell faq">
      <div class="faq__head reveal">
        <p class="eyebrow eyebrow--dot">Fragen &amp; Antworten</p>
        <h2>Häufige Fragen aus {location.city}</h2>
        <p class="faq__intro">Was uns Betriebe {location.inCity} vor dem ersten Termin fragen.</p>
      </div>
      <div class="faq__list">
        {
          location.faq.map((entry, index) => (
            <details class="faq__item reveal" style={`--d:${index * 0.04}s`} open={index === 0}>
              <summary>
                <>
                  <span>{entry.q}</span>
                  <i aria-hidden="true" />
                </>
              </summary>
              <p>{entry.a}</p>
            </details>
          ))
        }
      </div>
    </div>

    <div class="shell faq__cross">
      <p class="eyebrow">Auch im Einsatz</p>
      <div class="faq__links">
        {nearby.map((entry) => <a href={`/webdesign/${entry.slug}/`}>{entry.city}</a>)}
        <a href="/webdesign/">Alle Standorte</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .local-grid {
    display: grid;
    grid-template-columns: 1.15fr 0.85fr;
    gap: clamp(24px, 5vw, 64px);
    align-items: start;
  }
  .local-text {
    margin-top: var(--sp-4);
    font-size: var(--fs-sm);
    line-height: 1.8;
    color: var(--ink-2);
    max-width: 54ch;
  }
  .local-focus {
    list-style: none;
    padding: 0;
    margin-top: var(--sp-5);
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  .local-focus li {
    padding: 7px 13px;
    border: 1px solid var(--line-2);
    border-radius: 999px;
    background: var(--panel);
    font-family: var(--font-mono);
    font-size: var(--fs-mono);
    letter-spacing: 0.06em;
    color: var(--ink-3);
  }
  .local-card {
    padding: var(--sp-5);
    border: 1px solid var(--line-2);
    border-radius: var(--r-3);
    background: linear-gradient(150deg, var(--panel), var(--panel-3));
    box-shadow: 0 26px 46px -36px #2c334040;
  }
  .local-card__row {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: var(--sp-4);
    padding-bottom: var(--sp-3);
    margin-bottom: var(--sp-3);
    border-bottom: 1px dashed var(--line-2);
  }
  .local-card__row span {
    font-family: var(--font-mono);
    font-size: var(--fs-mono);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--ink-4);
  }
  .local-card__row b {
    font-size: var(--fs-sm);
    font-weight: 520;
    text-align: right;
    overflow-wrap: anywhere;
  }
  .local-card__row a {
    color: var(--ink);
    border-bottom: 1px solid var(--line-3);
  }
  .local-card__cta {
    width: 100%;
    margin-top: var(--sp-2);
  }
  .local-offers {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: clamp(12px, 1.6vw, 18px);
    margin-top: var(--sp-6);
  }
  .local-offer {
    position: relative;
    display: grid;
    gap: 6px;
    padding: var(--sp-5);
    border: 1px solid var(--line);
    border-radius: var(--r-2);
    background: var(--panel);
    transition:
      transform 0.3s var(--e),
      border-color 0.3s;
  }
  .local-offer:hover {
    transform: translateY(-3px);
    border-color: var(--brand);
  }
  .local-offer b {
    font-size: var(--fs-md);
    font-weight: 540;
    letter-spacing: -0.015em;
  }
  .local-offer span {
    font-size: var(--fs-sm);
    line-height: 1.6;
    color: var(--ink-3);
  }
  .local-offer i {
    position: absolute;
    top: var(--sp-4);
    right: var(--sp-4);
    font-style: normal;
    color: var(--ink-4);
    transition:
      color 0.25s,
      transform 0.25s;
  }
  .local-offer:hover i {
    color: var(--brand);
    transform: translate(2px, -2px);
  }
  @media (max-width: 940px) {
    .local-grid {
      grid-template-columns: 1fr;
    }
    .local-offers {
      grid-template-columns: 1fr 1fr;
    }
  }
  @media (max-width: 620px) {
    .local-offers {
      grid-template-columns: 1fr;
    }
  }
</style>
